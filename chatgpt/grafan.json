            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "orientation": "auto"
            },
            "targets": [
                {
                    "expr": "iceberg_snapshot_total_file_size_bytes{catalog=~\"$catalog\",namespace=~\"$namespace\",table=~\"$table\"}",
                    "refId": "A"
