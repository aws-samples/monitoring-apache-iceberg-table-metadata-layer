                    "expr": "increase(iceberg_snapshot_added_files_size_bytes_total{catalog=~\"$catalog\",namespace=~\"$namespace\",table=~\"$table\"}[5m])",
                    "legendFormat": "added bytes",
                    "refId": "A"
                },
                {
                    "expr": "increase(iceberg_snapshot_removed_files_size_bytes_total{catalog=~\"$catalog\",namespace=~\"$namespace\",table=~\"$table\"}[5m])",
                    "legendFormat": "removed bytes",
                    "refId": "B"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "decbytes"
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
