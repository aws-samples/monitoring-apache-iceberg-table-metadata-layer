                "overrides": []
            },
            "targets": [
                {
                    "expr": "iceberg_files_small_file_count{catalog=~\"$catalog\",namespace=~\"$namespace\",table=~\"$table\",threshold_bytes=\"33554432\"}",
                    "refId": "A"
                }
            ]
        },
        {
            "type": "stat",
            "title": "Delete File Ratio",
            "gridPos": {
                "x": 8,
                "y": 34,
                "w": 8,
                "h": 4
            },
            "id": 19,
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percent"
