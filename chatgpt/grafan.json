            "id": 21,
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "targets": [
                {
                    "expr": "iceberg_partition_size_bytes{catalog=~\"$catalog\",namespace=~\"$namespace\",table=~\"$table\"}",
                    "refId": "A",
                    "instant": true,
                    "format": "table"
                }
            ],
            "options": {
                "showHeader": true
            },
            "transformations": [
                {
                    "id": "labelsToFields",
                    "options": {
                        "mode": "columns"
                    }
                },
                {
                    "id": "organize",
                    "options": {
                        "excludeByName": {
                            "Time": true
                        },
                        "renameByName": {
                            "Value": "size_bytes"
                        }
                    }
                }
            ]
